<div class="d-flex flex-row">
  <h1 class="text-4xl font-bold underline mb-6">Forecast App</h1>
  <div>
    <p class="mb-4">Please inform your address (it can be a zipcode or a city name):</p>
    <%= form_with url: dashboard_search_path, method: :post, class: 'flex' do |form| %>
      <%= form.search_field :q, type: 'text', class: 'bg-neutral-secondary-medium border border-default-medium text-heading text-base rounded-base focus:ring-brand focus:border-brand block w-full px-4 py-3.5 shadow-xs placeholder:text-body' %>
      <%= form.submit "Search", type: 'submit', class: 'text-white hover:text-grey bg-brand box-border border shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none ml-2 cursor-pointer bg-blue-500 hover:bg-blue-600' %>
    <% end %>
  </div>
</div>