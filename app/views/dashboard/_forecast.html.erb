<% if error %>
  <div role="alert" class="mx-auto w-full max-w-xl rounded-2xl bg-white p-6 shadow-lg">
    <p class="text-red-700"><%= error %></p>
  </div>
<% else %>
  <% forecast = result.forecast %>
  <% place, region = place_parts(result.location) %>

  <article class="relative mx-auto w-full max-w-xl">
    <div aria-hidden="true" class="absolute inset-x-4 top-6 -bottom-4 rounded-2xl bg-linear-to-b from-transparent to-black/30 blur-xl"></div>

    <div class="relative rounded-2xl bg-white p-6 sm:p-8">
      <header class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="truncate text-2xl font-semibold"><%= place %></h2>
          <p class="mt-0.5 truncate text-sm text-gray-600" title="<%= result.location.name %>"><%= region %></p>
        </div>
        <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700"><%= forecast.feel.capitalize %></span>
      </header>

      <div class="mt-6 flex items-center justify-between gap-4">
        <div>
          <p class="text-sm text-gray-600"><%= Time.current.in_time_zone(forecast.timezone || Time.zone).to_date.to_fs(:long) %></p>
          <p class="mt-1 text-7xl font-light">
            <span class="sr-only">Current temperature: </span><%= forecast.current_temperature.round %>°<span class="align-top text-2xl text-gray-400"><%= forecast.unit.delete("°") %></span>
          </p>
        </div>
        <%= image_tag "weather/#{forecast.feel}.svg", alt: "#{forecast.feel.capitalize} weather", class: "size-28 shrink-0" %>
      </div>

      <p class="mt-6 text-sm text-gray-600">
        Min <%= forecast.min_temperature %> <%= forecast.unit %> · Max <%= forecast.max_temperature %> <%= forecast.unit %>
      </p>

      <footer class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-gray-100 pt-4 text-xs text-gray-500">
        <span>Searched for "<%= result.query %>"</span>
        <% if result.cached? %>
          <span class="text-amber-700">Served from cache (fetched <%= time_ago_in_words(forecast.fetched_at) %> ago)</span>
        <% end %>
      </footer>
    </div>
  </article>
<% end %>
