<div class="container mx-auto mt-10 flex flex-col">
  <% if error %>
    <p class="text-red-700"><%= error %></p>
  <% else %>
    <% forecast = result.forecast %>
    <h3 class="text-xl"><strong>Forecast result for: </strong>"<%= result.query %>"</h3>
    <p class="mt-1 text-sm text-gray-600"><%= result.location.name %></p>

    <% if result.cached? %>
      <p class="mt-2 inline-block text-sm text-amber-700">
        Served from cache (fetched <%= time_ago_in_words(forecast.fetched_at) %> ago)
      </p>
    <% end %>

    <p class="mt-2"><strong>Current date: </strong><%= Time.current.in_time_zone(forecast.timezone || Time.zone).to_date.to_fs(:long) %></p>
    <p class="mt-2"><strong>Current temperature: </strong><%= forecast.current_temperature %> <%= forecast.unit %></p>
    <p class="mt-2"><strong>Max temperature: </strong><%= forecast.max_temperature %> <%= forecast.unit %></p>
    <p class="mt-2"><strong>Min temperature: </strong><%= forecast.min_temperature %> <%= forecast.unit %></p>
  <% end %>
</div>
